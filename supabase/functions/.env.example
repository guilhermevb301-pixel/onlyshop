# Chaves usadas pelas edge functions do OnlyShop.
# COPIE este arquivo para `.env` (que é gitignorado) e preencha a sua chave.
#
#   cp supabase/functions/.env.example supabase/functions/.env
#
# Depois, pra usar em produção, suba como secret no Supabase:
#   supabase secrets set FAL_KEY=sua_chave_aqui

# fal.ai — geração de vídeo (Seedance/Kling/Veo). Pegue em https://fal.ai/dashboard/keys
FAL_KEY=

# LOVABLE_API_KEY já está configurada no projeto Supabase (usada pelo ai-copilot).
# Só preencha localmente se for rodar as functions no seu próprio Supabase.
LOVABLE_API_KEY=
